# "local"  -> usa catalogo/src/data/productos.js (no depende de Supabase/backend).
# "api"    -> pide productos a VITE_API_URL/publico/productos (con fallback
#             automático a local si la llamada falla).
VITE_DATA_SOURCE=local

# Solo se usa si VITE_DATA_SOURCE=api (o como intento best-effort al enviar
# un pedido, ver intentarCrearSolicitudEnERP en src/api.js).
VITE_API_URL=http://localhost:4000/api

# Número de WhatsApp Business de PanaPrice, SOLO dígitos con código de país
# (ej. 584121234567 — sin +, espacios ni guiones). Sin esto configurado el
# botón de enviar pedido no puede abrir WhatsApp.
VITE_WHATSAPP_NUMERO=
