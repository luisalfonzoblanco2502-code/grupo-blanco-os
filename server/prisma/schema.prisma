// ============================================================================
// Grupo Blanco OS — schema.prisma
//
// Este archivo describe el schema PÚBLICO que YA EXISTE en el proyecto de
// Supabase "grupo-blanco-os". No fue creado por Prisma y Prisma NO debe
// asumir que le pertenece: es fuente oficial de verdad, escrita a mano
// a partir de introspección de solo lectura (2026-07-26).
//
// REGLAS para quien edite este archivo:
//   1. No renombrar columnas/tablas reales vía @map/@@map sin verificar
//      contra la base real — @map/@@map aquí documentan nombres YA EXISTENTES.
//   2. No correr `prisma migrate dev` / `db push` contra este schema sin
//      revisar el SQL generado primero (ver notas de CHECK constraints e
//      índices parciales más abajo — Prisma no puede expresarlos y podría
//      proponer alterarlos/eliminarlos).
//   3. El schema `auth` (Supabase Auth) NO se modela aquí a propósito.
//      `usuarios.authUserId` es un UUID plano sin relación Prisma porque
//      no existe una FK real hacia auth.users (se valida por convención).
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// NÚCLEO
// ----------------------------------------------------------------------------

/// Cada empresa del grupo (Panaprice Custom, Punto Ele, Grupo Blanco, futuras).
/// Hoy solo existe 1 fila ("Grupo Blanco"). RLS: NO habilitado todavía.
model Empresa {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre   String
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuarios          Usuario[]
  pedidos           Pedido[]
  ordenesProduccion OrdenProduccion[]
  bitacoraEventos   BitacoraEvento[]
  auditoriaSistema  AuditoriaSistema[]
  productos         Producto[]
  solicitudesPedido SolicitudPedido[]

  // Facturador Administrativo Inteligente (2026-07-28)
  productosInternos     ProductoInterno[]
  clientes              Cliente[]
  documentosVenta       DocumentoVenta[]
  cajasCuentas          CajaCuenta[]
  pagosIngresos         PagoIngreso[]
  egresos               Egreso[]
  itemsInventario       ItemInventario[]
  productoInsumos       ProductoInsumo[]
  movimientosInventario MovimientoInventario[]
  costosPedido          CostoPedido[]
  pedidoLineas          PedidoLinea[]
  archivosAdjuntos      ArchivoAdjunto[]

  // ATLAS — Centro de Atención Inteligente (2026-07-31)
  atlasContactos        AtlasContacto[]
  atlasIdentidadesCanal AtlasIdentidadCanal[]
  atlasAtribucionTokens AtlasAtribucionToken[]

  @@map("empresas")
}

/// Perfil de negocio de cada persona. Se vincula a Supabase Auth vía
/// authUserId (auth.users.id) — SIN relación Prisma, ver nota de cabecera.
/// RLS: NO habilitado todavía.
model Usuario {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Corresponde a auth.users.id (Supabase Auth). No toda fila lo tiene:
  /// hay usuarios de negocio sin acceso de login todavía.
  authUserId String?  @unique @map("auth_user_id") @db.Uuid
  empresaId  String   @map("empresa_id") @db.Uuid
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  nombre     String
  email      String   @unique
  rolId      String   @map("rol_id") @db.Uuid
  rol        Rol      @relation(fields: [rolId], references: [id])
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  puestoId   Int?     @map("puesto_id")
  puesto     Puesto?  @relation(fields: [puestoId], references: [id])

  pedidosCreados     Pedido[]           @relation("PedidoCreadoPor")
  ordenesResponsable OrdenProduccion[]  @relation("OrdenResponsableUsuario")
  bitacoraEventos    BitacoraEvento[]
  auditoriaSistema   AuditoriaSistema[]
  pagosRegistrados   PagoIngreso[]
  egresosRegistrados Egreso[]
  movimientosInventario MovimientoInventario[]
  archivosAdjuntos   ArchivoAdjunto[]
  atlasContactosResponsable AtlasContacto[]

  @@map("usuarios")
}

/// Rol de acceso. `permisos` es un mapa JSONB de permisos con nombre
/// (crear_pedido, cambiar_etapa, gestionar_usuarios, etc.), NO una tabla
/// relacional Rol-Permiso. Es GLOBAL (sin empresaId) — ver plan de RLS
/// para la decisión pendiente sobre si esto debe seguir así.
model Rol {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre   String   @unique
  permisos Json     @default("{}")
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuarios Usuario[]

  @@map("roles")
}

/// Posición laboral (Vendedor, Diseñador, Operador de plotter, ...).
/// GLOBAL (sin empresaId) — mismo punto de decisión que Rol/Etapa/Prioridad.
model Puesto {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  usuarios Usuario[]
  etapas   Etapa[]

  @@map("puestos")
}

// ----------------------------------------------------------------------------
// PRODUCCIÓN (existente — Pedido y OrdenProduccion son entidades separadas)
// ----------------------------------------------------------------------------

/// Lo que pidió el cliente. clienteNombre sigue siendo TEXTO LIBRE (no se
/// modificó); clienteId es un enlace ADITIVO y opcional hacia la ficha real
/// de Cliente (Facturador Administrativo, 2026-07-28) — NULL en todo pedido
/// creado antes de esta fase, incluidos los de prueba PED-0013/0014/0015
/// (decisión explícita: sin backfill).
model Pedido {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId       String    @map("empresa_id") @db.Uuid
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  /// Identificador legible de negocio, único por empresa (no global).
  pedId           String    @map("ped_id")
  clienteNombre   String    @map("cliente_nombre")
  clienteId       String?   @map("cliente_id") @db.Uuid
  cliente         Cliente?  @relation(fields: [clienteId], references: [id])
  fechaIngreso    DateTime  @map("fecha_ingreso") @db.Date
  fechaCompromiso DateTime  @map("fecha_compromiso") @db.Date
  /// CHECK constraint en BD: cantidad_total > 0 (no expresable en Prisma DSL).
  /// Producción Operativa (2026-07-28): ya NO se acepta como input manual —
  /// se recalcula en pedidoLineas.service.js desde la suma de PedidoLinea.cantidad
  /// cada vez que una línea se crea/edita/elimina.
  cantidadTotal   Int       @map("cantidad_total")
  observaciones   String?
  /// Aditivos (Producción Operativa, 2026-07-28) — NULL en pedidos anteriores.
  tipoEntrega     String?   @map("tipo_entrega")
  direccionAgencia String?  @map("direccion_agencia")
  prioridadId     Int?      @map("prioridad_id")
  prioridad       Prioridad? @relation(fields: [prioridadId], references: [id])
  creadoPorId     String?   @map("creado_por") @db.Uuid
  creadoPor       Usuario?  @relation("PedidoCreadoPor", fields: [creadoPorId], references: [id])
  creadoEn        DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn   DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  /// Soft delete. Toda query de negocio debe filtrar eliminadoEn: null.
  eliminadoEn     DateTime? @map("eliminado_en") @db.Timestamptz(6)
  /// Idempotencia mínima de POST /api/pedidos (Paso 6.1, 2026-07-31) — UUID
  /// generado por el frontend UNA vez por borrador, enviado en cada intento
  /// de creación. Nullable a propósito: pedidos históricos y cualquier vía
  /// que no la mande siguen funcionando igual (Postgres permite múltiples
  /// NULL en un UNIQUE estándar). Exclusiva de la creación — nunca se edita
  /// después (ver editarPedido, que no la toca).
  claveIdempotencia String?   @map("clave_idempotencia") @db.Uuid

  ordenesProduccion OrdenProduccion[]
  solicitudesOrigen SolicitudPedido[]
  documentoVenta    DocumentoVenta?
  costos            CostoPedido?
  movimientosInventario MovimientoInventario[]
  lineas            PedidoLinea[]
  atlasContactos    AtlasContacto[]

  @@unique([empresaId, pedId])
  @@unique([empresaId, claveIdempotencia], map: "uq_pedidos_empresa_clave_idempotencia")
  @@map("pedidos")
}

/// Unidad de trabajo en planta. Un Pedido puede generar varias
/// OrdenProduccion independientes (una por producto/línea).
///
/// CHECK constraint en BD (no expresable en Prisma DSL, DEBE validarse
/// también en la app): exactamente uno de responsableUsuarioId /
/// responsableExterno debe estar presente (XOR).
model OrdenProduccion {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId             String    @map("pedido_id") @db.Uuid
  pedido               Pedido    @relation(fields: [pedidoId], references: [id])
  empresaId            String    @map("empresa_id") @db.Uuid
  empresa              Empresa   @relation(fields: [empresaId], references: [id])
  /// Identificador legible de negocio, único por empresa.
  opId                 String    @map("op_id")
  /// Producto/tipo de trabajo/medida son TEXTO LIBRE — no existe catálogo
  /// de productos todavía (a propósito, no se crea en esta fase).
  producto             String
  /// CHECK constraint en BD: cantidad > 0.
  cantidad             Int
  tipoTrabajo          String?   @map("tipo_trabajo")
  medida               String?
  etapaId              Int       @map("etapa_id")
  etapa                Etapa     @relation(fields: [etapaId], references: [id])
  prioridadId          Int       @map("prioridad_id")
  prioridad            Prioridad @relation(fields: [prioridadId], references: [id])
  responsableUsuarioId String?   @map("responsable_usuario_id") @db.Uuid
  responsableUsuario   Usuario?  @relation("OrdenResponsableUsuario", fields: [responsableUsuarioId], references: [id])
  /// Texto libre para trabajo tercerizado (ej. confección externa).
  responsableExterno   String?   @map("responsable_externo")
  fechaEntregaReal     DateTime? @map("fecha_entrega_real") @db.Date
  observaciones        String?
  /// Enlace ADITIVO hacia el Catálogo Interno de Productos (Facturador
  /// Administrativo, 2026-07-28) — necesario para saber qué BOM consumir al
  /// llegar a la etapa Corte. NULL en órdenes creadas antes de esta fase o
  /// facturadas sin elegir un producto del catálogo.
  productoInternoId    String?   @map("producto_interno_id") @db.Uuid
  productoInterno      ProductoInterno? @relation(fields: [productoInternoId], references: [id])
  /// Snapshot técnico copiado de PedidoLinea al facturar (Producción
  /// Operativa, 2026-07-28) — deliberadamente INDEPENDIENTE de la línea
  /// comercial: si la línea cambia después, la OP no se entera (ver
  /// pedidoLineaId más abajo, que es solo trazabilidad/idempotencia, no una
  /// relación viva que la OP consulte en cada lectura).
  descripcion          String?
  talla                String?
  tela                 String?
  color                String?
  tipoImpresion        String?   @map("tipo_impresion")
  forro                String?
  tiras                String?
  insumos              String?
  /// Ancla de idempotencia: UNA orden nace de UNA línea, una sola vez.
  /// Reprocesar PEDIDO_FACTURADO no puede duplicar la OP porque el segundo
  /// intento de create() choca con este UNIQUE.
  /// LEGACY (mantenido por compatibilidad, ver PedidoLinea.ordenProduccionId
  /// más abajo para el camino de lectura real de "OP agrupada"): ancla de
  /// idempotencia de cuando una OP nacía de UNA sola línea. Toda OP creada
  /// antes de la migración de "OP agrupada por lote" (2026-07-29) la tiene;
  /// las OP nuevas ya no la usan como mecanismo de idempotencia (ver
  /// `variantes` abajo), pero se sigue completando cuando el grupo es de 1
  /// sola línea, por compatibilidad temporal de lectura.
  pedidoLineaId        String?   @unique @map("pedido_linea_id") @db.Uuid
  pedidoLinea          PedidoLinea? @relation("OrdenLineaOrigenLegacy", fields: [pedidoLineaId], references: [id])
  creadoEn             DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn        DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  eliminadoEn          DateTime? @map("eliminado_en") @db.Timestamptz(6)

  bitacoraEventos BitacoraEvento[]
  movimientosInventario MovimientoInventario[]
  archivosAdjuntos ArchivoAdjunto[]
  /// Camino de lectura real de "OP agrupada" (2026-07-29): todas las
  /// PedidoLinea que este lote agrupa, sea 1 (caso legacy tras el backfill)
  /// o varias (caso nuevo). Impresión/detalle/API deben leer variantes acá,
  /// nunca mezclando con las columnas snapshot de arriba (ver nota en
  /// PedidoLinea.ordenProduccionId).
  variantes       PedidoLinea[] @relation("OrdenVariantes")

  @@unique([empresaId, opId])
  // Nota: en la BD real estos dos índices son PARCIALES (WHERE eliminado_en
  // IS NULL). Prisma no soporta índices parciales en su DSL — estas
  // declaraciones son una aproximación. NO correr `migrate dev`/`db push`
  // sin revisar el diff: Prisma podría proponer recrearlos sin el WHERE.
  @@index([pedidoId], map: "idx_op_pedido")
  @@index([responsableUsuarioId], map: "idx_op_responsable")
  @@index([empresaId, etapaId], map: "idx_op_empresa_etapa")
  @@map("ordenes_produccion")
}

/// Pipeline de producción, configurable en base de datos (no hardcodeado).
/// GLOBAL (sin empresaId) — punto de decisión pendiente: ¿todas las
/// empresas del grupo comparten el mismo pipeline de etapas?
model Etapa {
  id                Int     @id @default(autoincrement())
  nombre            String  @unique
  /// Orden secuencial del pipeline (no hay tabla de "transiciones
  /// permitidas" — a diferencia del prototipo anterior de este repo).
  orden             Int     @unique
  puestoRequeridoId Int?    @map("puesto_requerido_id")
  puestoRequerido   Puesto? @relation(fields: [puestoRequeridoId], references: [id])
  requiereExterno   Boolean @default(false) @map("requiere_externo")

  ordenesProduccion OrdenProduccion[]
  movimientosInventario MovimientoInventario[]

  @@map("etapas")
}

/// GLOBAL (sin empresaId) — mismo punto de decisión que Etapa/Rol/Puesto.
model Prioridad {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  peso   Int    @unique

  ordenesProduccion OrdenProduccion[]
  pedidos           Pedido[]
  pedidoLineas      PedidoLinea[]

  @@map("prioridades")
}

/// Historial de cambios de una OrdenProduccion, genérico (campo/valor
/// anterior/valor nuevo), NO solo de estado. Protegido por trigger de BD
/// `bloquear_modificacion_bitacora`: UPDATE y DELETE están bloqueados a
/// nivel de Postgres, sin importar permisos de aplicación. Es la app
/// (Express) la que inserta estas filas — no hay trigger que lo automatice.
model BitacoraEvento {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordenProduccionId String          @map("orden_produccion_id") @db.Uuid
  ordenProduccion   OrdenProduccion @relation(fields: [ordenProduccionId], references: [id])
  empresaId         String          @map("empresa_id") @db.Uuid
  empresa           Empresa         @relation(fields: [empresaId], references: [id])
  tipoEvento        String          @map("tipo_evento")
  campoAfectado     String?         @map("campo_afectado")
  valorAnterior     String?         @map("valor_anterior")
  valorNuevo        String?         @map("valor_nuevo")
  usuarioId         String?         @map("usuario_id") @db.Uuid
  usuario           Usuario?        @relation(fields: [usuarioId], references: [id])
  ocurridoEn        DateTime        @default(now()) @map("ocurrido_en") @db.Timestamptz(6)

  @@map("bitacora_eventos")
}

/// Auditoría de seguridad (quién hizo qué acción, desde qué IP). Existe
/// pero tiene 0 filas — todavía no se usa. RLS: NO habilitado (gap de
/// seguridad más urgente, ver plan de RLS).
model AuditoriaSistema {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId  String?  @map("empresa_id") @db.Uuid
  empresa    Empresa? @relation(fields: [empresaId], references: [id])
  usuarioId  String?  @map("usuario_id") @db.Uuid
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  accion     String
  detalle    Json?
  ip         String?
  ocurridoEn DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(6)

  @@map("auditoria_sistema")
}

/// ----------------------------------------------------------------------------
// CATÁLOGO PÚBLICO Y SOLICITUDES DE PEDIDO (Sprint 10)
//
// Objetivo: catalogo.panaprice.com muestra Producto (solo activo+publicado),
// el cliente arma un carrito y envía una SolicitudPedido SIN autenticarse.
// El equipo la revisa en el ERP y, al aprobarla, `solicitudes.service.js`
// llama al `crearPedido()` YA EXISTENTE en pedidos.service.js — no se
// duplica lógica de negocio, el resto del flujo (facturar → producción)
// es el mismo de siempre.
// ----------------------------------------------------------------------------

/// Producto vendible en el catálogo público. `activo` = utilizable en el
/// sistema en general; `publicadoCatalogo` = visible en catalogo.panaprice.com.
/// Son independientes a propósito: un producto puede estar activo para uso
/// interno (ej. referenciarlo en una Orden de Producción manual) sin todavía
/// estar listo para mostrarse a clientes.
model Producto {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String    @map("empresa_id") @db.Uuid
  empresa           Empresa   @relation(fields: [empresaId], references: [id])
  /// Código legible que ve el cliente en el catálogo y en el mensaje de
  /// WhatsApp (ej. "PAN-001"). Lo escribe quien carga el producto desde el
  /// ERP — no es autogenerado como pedId/opId porque acá el negocio quiere
  /// controlar su propia numeración de diseños.
  codigo            String
  nombre            String
  /// Texto libre por ahora (ej. "panoleta", "pareo") — mismo criterio que
  /// OrdenProduccion.tipoTrabajo: no existe todavía una tabla de categorías.
  categoria         String
  descripcion       String?
  imagenUrl         String?   @map("imagen_url")
  /// Precio de referencia mostrado en el catálogo antes de aplicar
  /// descuentos por volumen (ver ProductoPrecioVolumen).
  precioBase        Decimal   @map("precio_base") @db.Decimal(10, 2)
  activo            Boolean   @default(true)
  publicadoCatalogo Boolean   @default(false) @map("publicado_catalogo")
  /// Independiente de activo/publicadoCatalogo: un producto puede seguir
  /// visible en catálogo pero marcado "agotado" (disponible=false) en vez
  /// de desaparecer del todo.
  disponible        Boolean   @default(true)
  creadoEn          DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn     DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  eliminadoEn       DateTime? @map("eliminado_en") @db.Timestamptz(6)
  /// Puente ADITIVO hacia el Catálogo Interno (Fase 1, sprint "Catálogo ->
  /// Solicitud -> Pedido", 2026-07-30) — opcional a propósito ("primero
  /// sugerir, nunca obligar"): un producto comercial sin vínculo se vende
  /// exactamente igual que hoy, sin reserva de inventario. Cuando SÍ está
  /// vinculado, la conversión Solicitud->Pedido y la venta directa heredan
  /// este valor hacia PedidoLinea.productoInternoId, y desde ahí el flujo de
  /// facturación/inventario YA existente (sin cambios) reserva el BOM real.
  /// NUNCA se expone en /api/publico/productos (ver productos.service.js).
  productoInternoId String?   @map("producto_interno_id") @db.Uuid
  productoInterno   ProductoInterno? @relation(fields: [productoInternoId], references: [id])

  /// Producto Maestro (2026-07-31, arquitectura aprobada "el pedido no
  /// construye el producto"): especificación técnica PERMANENTE del
  /// producto, ya sea de catálogo (requierePersonalizacion=false) o
  /// personalizable (true, una fila por talla — ej. "Bolero S/M"). Se
  /// COPIA una sola vez a PedidoLinea al crear la línea (ver
  /// PedidoLinea.productoMaestro) — cambiar esto después NUNCA reescribe
  /// pedidos ya capturados.
  requierePersonalizacion       Boolean  @default(false) @map("requiere_personalizacion")
  /// Foto permanente del MODELO FÍSICO a fabricar (miniatura izquierda en
  /// Diseño/Producción) — distinta de `imagenUrl`, que es la foto comercial
  /// del catálogo.
  imagenReferenciaProduccionUrl String? @map("imagen_referencia_produccion_url")
  talla                         String?
  medidas                       String?
  tela                          String?
  tipoImpresion                 String? @map("tipo_impresion")
  forro                         String?
  tiras                         String?
  /// Texto libre descriptivo ("qué insumos usa") — no confundir con
  /// ProductoInsumo, que es el BOM real por FK (Fase 1).
  insumosDescripcion            String? @map("insumos_descripcion")
  moldeUrl                      String? @map("molde_url")
  tiempoProduccionMinutos       Int?    @map("tiempo_produccion_minutos")
  instruccionesProduccion       String? @map("instrucciones_produccion")

  preciosVolumen ProductoPrecioVolumen[]
  solicitudItems SolicitudPedidoItem[]
  pedidoLineas   PedidoLinea[]

  @@unique([empresaId, codigo])
  @@index([empresaId, publicadoCatalogo, activo])
  @@index([productoInternoId], map: "idx_productos_producto_interno")
  @@map("productos")
}

/// Escalón de precio por volumen: "a partir de cantidadMinima unidades,
/// precioUnitario". El primer escalón (cantidadMinima más baja) normalmente
/// coincide con precioBase, pero no se fuerza esa igualdad en el modelo.
model ProductoPrecioVolumen {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productoId     String   @map("producto_id") @db.Uuid
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidadMinima Int      @map("cantidad_minima")
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(10, 2)

  @@index([productoId])
  @@map("producto_precios_volumen")
}

/// Solicitud enviada desde el catálogo público (sin autenticación). A
/// diferencia de `pedidos`, esta tabla SÍ tiene columna `estado` mutable: es
/// una tabla nueva (sin la restricción histórica de `pedidos`, ver
/// pedidoEstado.service.js) y el equipo necesita poder filtrar rápido
/// "solicitudes pendientes de revisión" como bandeja de entrada, sin
/// recalcular el estado desde un log de eventos en cada consulta.
model SolicitudPedido {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId            String    @map("empresa_id") @db.Uuid
  empresa              Empresa   @relation(fields: [empresaId], references: [id])
  /// Identificador legible de negocio, único por empresa (mismo patrón que
  /// Pedido.pedId / OrdenProduccion.opId).
  solId                String    @map("sol_id")
  clienteNombre        String    @map("cliente_nombre")
  clienteTelefono      String    @map("cliente_telefono")
  clienteEmail         String?   @map("cliente_email")
  notasPersonalizacion String?   @map("notas_personalizacion")
  /// RECIBIDA | EN_REVISION | APROBADA | RECHAZADA | CORRECCION_SOLICITADA | CONVERTIDA
  /// (ver ESTADOS_SOLICITUD en solicitudes.service.js).
  estado               String    @default("RECIBIDA")
  motivoRechazo        String?   @map("motivo_rechazo")
  /// Se completa únicamente cuando estado pasa a CONVERTIDA.
  pedidoId             String?   @map("pedido_id") @db.Uuid
  pedido               Pedido?   @relation(fields: [pedidoId], references: [id])
  /// Número de orden público (ej. "PP-2026-000154"), generado por
  /// crearSolicitudPublica con el mismo patrón que solId (ver
  /// siguienteNumeroOrdenPublico). Lo usa el cliente en "Rastrea tu pedido"
  /// (GET /api/publico/rastreo/:numeroOrden). Nullable: solicitudes previas
  /// al módulo de rastreo no lo tienen.
  numeroOrden          String?   @map("numero_orden")
  /// Estado de producción/entrega visible para el CLIENTE — distinto de
  /// `estado` (que es el flujo de revisión interno de staff:
  /// RECIBIDA/EN_REVISION/APROBADA/...). Ver ETAPAS_PUBLICAS en
  /// solicitudes.service.js para los valores válidos y su orden.
  estadoPublico        String    @default("RECIBIDO") @map("estado_publico")
  /// RETIRO | ENVIO — elegido por el cliente en el checkout del catálogo.
  tipoEntrega          String?   @map("tipo_entrega")
  /// Solo aplica si tipoEntrega = ENVIO; texto libre por ahora (MRW, Zoom,
  /// Tealca, Domesa...) — no hay UI en el ERP todavía para completarlo
  /// (queda para el sprint que agregue gestión de despacho en /solicitudes).
  agenciaEnvio         String?   @map("agencia_envio")
  creadoEn             DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn        DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  items SolicitudPedidoItem[]

  @@unique([empresaId, solId])
  @@unique([empresaId, numeroOrden])
  @@index([empresaId, estado])
  @@map("solicitudes_pedido")
}

/// Línea de una SolicitudPedido: un producto, cantidad y notas de
/// personalización/diseño puntuales de esa línea (ej. "logo en la esquina
/// superior izquierda"). El precio unitario estimado se congela al crear la
/// solicitud (aplicando ProductoPrecioVolumen) para que cambios posteriores
/// de precio no alteren solicitudes ya enviadas.
model SolicitudPedidoItem {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solicitudId            String          @map("solicitud_id") @db.Uuid
  solicitud              SolicitudPedido @relation(fields: [solicitudId], references: [id])
  productoId             String          @map("producto_id") @db.Uuid
  producto               Producto        @relation(fields: [productoId], references: [id])
  cantidad               Int
  disenoNotas            String?         @map("diseno_notas")
  precioUnitarioEstimado Decimal?        @map("precio_unitario_estimado") @db.Decimal(10, 2)

  @@index([solicitudId])
  @@map("solicitud_pedido_items")
}

// ----------------------------------------------------------------------------
// FACTURADOR ADMINISTRATIVO INTELIGENTE (2026-07-28)
//
// Persistencia real de lo que hasta ahora vivía en 5 simuladores en memoria
// (server/src/services/administracion|inventario|crm|costos|
// indicadoresFacturacion.service.js — eliminados). Reacciona a
// PEDIDO_FACTURADO (documento + reserva + costo estimado) y a
// ORDEN_ETAPA_CAMBIADA en la etapa "Corte" (consumo real), ambos eventos ya
// existentes del Event Bus — no se tocó FacturacionService.
//
// Regla de oro del flujo: facturar RESERVA, nunca consume. El consumo
// definitivo ocurre recién cuando la orden entra a Corte. Cancelar antes de
// Corte libera la reserva (función lista, sin UI todavía — un pedido
// FACTURADO no es cancelable por el flujo actual, ver reporte).
// ----------------------------------------------------------------------------

/// Catálogo Interno de Productos — base del BOM. Independiente del catálogo
/// público (`Producto`, para catalogo.panaprice.com): este es de uso interno
/// para costear/reservar materiales, sin campos de venta al público.
model ProductoInterno {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String    @map("empresa_id") @db.Uuid
  empresa          Empresa   @relation(fields: [empresaId], references: [id])
  codigo           String
  nombre           String
  categoria        String?
  precioReferencia Decimal?  @map("precio_referencia") @db.Decimal(12, 2)
  activo           Boolean   @default(true)
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  insumos              ProductoInsumo[]
  ordenesProduccion    OrdenProduccion[]
  pedidoLineas         PedidoLinea[]
  /// Productos comerciales del catálogo público vinculados a este
  /// ProductoInterno (Fase 1, "Catálogo -> Solicitud -> Pedido") — puede ser
  /// más de uno (ej. varios colores/diseños comerciales comparten el mismo
  /// BOM de fabricación).
  productosComerciales Producto[]

  @@unique([empresaId, codigo])
  @@map("productos_internos")
}

/// Línea de un Pedido — captura estructurada de la vendedora, ANTES de
/// facturar (Producción Operativa, 2026-07-28). Al facturar, cada línea se
/// convierte en exactamente una OrdenProduccion (snapshot técnico copiado,
/// ver OrdenProduccion.pedidoLineaId) — "capturar una sola vez".
model PedidoLinea {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId               String    @map("empresa_id") @db.Uuid
  empresa                 Empresa   @relation(fields: [empresaId], references: [id])
  pedidoId                String    @map("pedido_id") @db.Uuid
  pedido                  Pedido    @relation(fields: [pedidoId], references: [id])
  ordenVisualizacion      Int       @default(0) @map("orden_visualizacion")
  productoInternoId       String?   @map("producto_interno_id") @db.Uuid
  productoInterno         ProductoInterno? @relation(fields: [productoInternoId], references: [id])
  producto                String
  descripcion             String?
  talla                   String?
  /// CHECK constraint en BD: cantidad > 0.
  cantidad                Int
  precioUnitario          Decimal?  @map("precio_unitario") @db.Decimal(12, 2)
  /// cantidad * precioUnitario, calculado en la app al guardar la línea.
  subtotal                Decimal?  @db.Decimal(12, 2)
  tela                    String?
  color                   String?
  tipoImpresion           String?   @map("tipo_impresion")
  forro                   String?
  tiras                   String?
  insumos                 String?
  medidas                 String?
  observacionesProduccion String?   @map("observaciones_produccion")
  prioridadId             Int?      @map("prioridad_id")
  prioridad               Prioridad? @relation(fields: [prioridadId], references: [id])
  creadoEn                DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn           DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  /// "OP agrupada por lote" (2026-07-29): a qué Orden de Producción pertenece
  /// esta línea/variante. NULL hasta que se factura. Reemplaza el camino de
  /// lectura de `ordenProduccionLegacy` (1:1) — varias líneas pueden apuntar
  /// a la MISMA OrdenProduccion cuando comparten producto/tela/tipo de
  /// impresión/prioridad/responsable (ver ordenesProduccion.service.js,
  /// claveDeGrupo). Backfill aplicado a toda OP histórica antes de esta
  /// migración, sin fusionar ni eliminar ninguna.
  ordenProduccionId       String?   @map("orden_produccion_id") @db.Uuid
  ordenProduccion         OrdenProduccion? @relation("OrdenVariantes", fields: [ordenProduccionId], references: [id])
  /// Checkbox "Separar en otra Orden de Producción" — desactivado por
  /// defecto. Si está activo, esta línea nunca se agrupa con otras al
  /// facturar, aunque coincidan técnicamente (override manual mínimo, sin
  /// editor de lotes).
  separarEnOtraOp         Boolean   @default(false) @map("separar_en_otra_op")

  /// Producto Maestro (2026-07-31): referencia opcional al Producto real
  /// elegido para esta línea. `producto` (String, arriba) sigue siendo el
  /// snapshot del NOMBRE — este campo es la relación viva al registro,
  /// usada solo para construir el snapshot al crear la línea; nunca se
  /// relee después (ver productoCodigo/imagenReferenciaProduccionUrl/
  /// moldeUrlSnapshot/tiempoProduccionMinutosSnapshot/
  /// instruccionesProduccionSnapshot más abajo, todos copiados una sola
  /// vez). `onDelete: SetNull`: si el Producto alguna vez se borra
  /// físicamente (hoy `eliminarProducto` solo hace soft-delete), el
  /// histórico de la línea sobrevive con `productoId = NULL`.
  productoId              String?   @map("producto_id") @db.Uuid
  productoMaestro         Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  /// Snapshot del código del Producto Maestro al momento de crear la línea.
  productoCodigo                      String?  @map("producto_codigo")
  /// Snapshot de Producto.imagenReferenciaProduccionUrl — miniatura
  /// izquierda en Diseño/Producción (qué modelo fabricar).
  imagenReferenciaProduccionUrl       String?  @map("imagen_referencia_produccion_url")
  moldeUrlSnapshot                    String?  @map("molde_url_snapshot")
  tiempoProduccionMinutosSnapshot     Int?     @map("tiempo_produccion_minutos_snapshot")
  /// Snapshot de Producto.instruccionesProduccion — DISTINTO de
  /// observacionesProduccion (arriba), que sigue siendo texto libre del
  /// cliente/vendedora por pedido. Nunca se mezclan.
  instruccionesProduccionSnapshot     String?  @map("instrucciones_produccion_snapshot")
  /// true únicamente si alguien editó a mano, vía "Caso excepcional /
  /// modificación avanzada", alguno de los 12 campos técnicos del snapshot
  /// (ver ESPECIFICACION_TECNICA_CAMPOS en pedidoLineas.service.js cuando
  /// exista) — nunca se activa por cambios de cantidad/precio/
  /// observaciones/prioridad/responsable/fecha/imagen del diseño.
  especificacionModificadaManualmente Boolean  @default(false) @map("especificacion_modificada_manualmente")

  /// LEGACY: back-relation de OrdenProduccion.pedidoLineaId (1:1, ver nota
  /// ahí). Se mantiene por compatibilidad de lectura, no se usa para crear
  /// OP nuevas.
  ordenProduccionLegacy  OrdenProduccion? @relation("OrdenLineaOrigenLegacy")
  archivosAdjuntos ArchivoAdjunto[]

  @@index([ordenProduccionId], map: "idx_pedido_lineas_orden_produccion")
  @@index([productoId], map: "idx_pedido_lineas_producto")
  @@map("pedido_lineas")
}

/// Imagen principal + adjuntos, tanto de una PedidoLinea (antes de
/// facturar) como de una OrdenProduccion (snapshot copiado al facturar —
/// misma `ubicacion` en Storage, fila de metadata duplicada, no se
/// re-sube el archivo). Pertenece a exactamente uno de los dos (CHECK en BD).
model ArchivoAdjunto {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String           @map("empresa_id") @db.Uuid
  empresa           Empresa          @relation(fields: [empresaId], references: [id])
  pedidoLineaId     String?          @map("pedido_linea_id") @db.Uuid
  pedidoLinea       PedidoLinea?     @relation(fields: [pedidoLineaId], references: [id])
  ordenProduccionId String?          @map("orden_produccion_id") @db.Uuid
  ordenProduccion   OrdenProduccion? @relation(fields: [ordenProduccionId], references: [id])
  esPrincipal       Boolean          @default(false) @map("es_principal")
  nombre            String
  tipo              String
  tamano            Int
  ubicacion         String
  usuarioId         String?          @map("usuario_id") @db.Uuid
  usuario           Usuario?         @relation(fields: [usuarioId], references: [id])
  creadoEn          DateTime         @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("archivos_adjuntos")
}

/// Ficha de identidad del cliente — SOLO identidad. Los totales/ticket
/// promedio/clasificación/saldo por cobrar se calculan agregando
/// DocumentoVenta en tiempo de lectura (crm.service.js), nunca se guardan
/// como contador mutable: así reprocesar PEDIDO_FACTURADO no puede
/// duplicar ni desalinear nada (ver estrategia de idempotencia del reporte).
model Cliente {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId  String   @map("empresa_id") @db.Uuid
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  nombre     String
  telefono   String?
  email      String?
  direccion  String?
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  pedidos         Pedido[]
  documentosVenta DocumentoVenta[]

  @@unique([empresaId, nombre])
  @@map("clientes")
}

/// Documento de venta — se crea una sola vez por pedido al facturar
/// (uq_documento_pedido). "Facturar no equivale a cobrar": estado EMITIDO no
/// implica pago, saldoPendiente arranca en total y baja con cada Pago.
model DocumentoVenta {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String    @map("empresa_id") @db.Uuid
  empresa        Empresa   @relation(fields: [empresaId], references: [id])
  pedidoId       String    @unique @map("pedido_id") @db.Uuid
  pedido         Pedido    @relation(fields: [pedidoId], references: [id])
  clienteId      String?   @map("cliente_id") @db.Uuid
  cliente        Cliente?  @relation(fields: [clienteId], references: [id])
  numero         String
  /// Snapshot del nombre al emitir — no cambia si el pedido ya no es editable.
  clienteNombre  String    @map("cliente_nombre")
  subtotal       Decimal   @db.Decimal(12, 2)
  descuentos     Decimal   @default(0) @db.Decimal(12, 2)
  impuestos      Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2)
  moneda         String    @default("USD")
  tasaCambio     Decimal   @default(1) @map("tasa_cambio") @db.Decimal(12, 6)
  /// EMITIDO | ANULADO
  estado         String    @default("EMITIDO")
  saldoPendiente Decimal   @map("saldo_pendiente") @db.Decimal(12, 2)
  fechaEmision   DateTime  @default(now()) @map("fecha_emision") @db.Timestamptz(6)
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn  DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  pagos PagoIngreso[]

  @@unique([empresaId, numero])
  @@map("documentos_venta")
}

/// Caja o cuenta bancaria — catálogo mínimo compartido por Pago/Egreso para
/// que "caja/cuenta" no sea texto libre (evita que un typo divida el saldo
/// de una misma caja en dos).
model CajaCuenta {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nombre    String
  /// CAJA | BANCO
  tipo      String   @default("CAJA")
  activa    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  pagos   PagoIngreso[]
  egresos Egreso[]

  @@unique([empresaId, nombre])
  @@map("cajas_cuentas")
}

/// Pago sobre un DocumentoVenta. Soporta pagos parciales desde el modelo:
/// N filas de Pago por un mismo documento, cada una baja saldoPendiente.
model PagoIngreso {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId              String        @map("empresa_id") @db.Uuid
  empresa                Empresa       @relation(fields: [empresaId], references: [id])
  documentoVentaId       String        @map("documento_venta_id") @db.Uuid
  documentoVenta         DocumentoVenta @relation(fields: [documentoVentaId], references: [id])
  monto                  Decimal       @db.Decimal(12, 2)
  moneda                 String        @default("USD")
  tasaCambio             Decimal       @default(1) @map("tasa_cambio") @db.Decimal(12, 6)
  metodoPago             String        @map("metodo_pago")
  cajaCuentaId           String        @map("caja_cuenta_id") @db.Uuid
  cajaCuenta             CajaCuenta    @relation(fields: [cajaCuentaId], references: [id])
  fecha                  DateTime      @default(now()) @db.Timestamptz(6)
  referencia             String?
  /// Opcional — para integraciones futuras (pasarela/webhook) que puedan
  /// reintentar la misma notificación sin crear el ingreso dos veces.
  referenciaIdempotencia String?       @map("referencia_idempotencia")
  /// CONFIRMADO | ANULADO
  estado                 String        @default("CONFIRMADO")
  registradoPorUsuarioId String?       @map("registrado_por_usuario_id") @db.Uuid
  registradoPor          Usuario?      @relation(fields: [registradoPorUsuarioId], references: [id])
  creadoEn               DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("pagos_ingresos")
}

/// Estructura lista, SIN flujo automático — fuera del Go Live del 5 de
/// agosto (decisión explícita). Nadie la dispara desde el Event Bus todavía.
model Egreso {
  id                     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId              String     @map("empresa_id") @db.Uuid
  empresa                Empresa    @relation(fields: [empresaId], references: [id])
  categoria              String
  proveedorBeneficiario  String     @map("proveedor_beneficiario")
  monto                  Decimal    @db.Decimal(12, 2)
  moneda                 String     @default("USD")
  tasaCambio             Decimal    @default(1) @map("tasa_cambio") @db.Decimal(12, 6)
  metodoPago             String     @map("metodo_pago")
  cajaCuentaId           String     @map("caja_cuenta_id") @db.Uuid
  cajaCuenta             CajaCuenta @relation(fields: [cajaCuentaId], references: [id])
  fecha                  DateTime   @default(now()) @db.Timestamptz(6)
  descripcion            String?
  referencia             String?
  estado                 String     @default("CONFIRMADO")
  registradoPorUsuarioId String?    @map("registrado_por_usuario_id") @db.Uuid
  registradoPor          Usuario?   @relation(fields: [registradoPorUsuarioId], references: [id])
  creadoEn               DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("egresos")
}

/// Ítem de inventario — hoy, en la práctica, materia prima/insumos (el
/// producto vendido vive en ProductoInterno). existenciaReservada separado
/// de existencia a propósito: reservar ≠ consumir (regla de oro del flujo).
/// Sin CHECK de existencia >= 0: sobreventa permitida y visible (decisión
/// aprobada), no bloqueada a nivel de base de datos.
model ItemInventario {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId           String   @map("empresa_id") @db.Uuid
  empresa             Empresa  @relation(fields: [empresaId], references: [id])
  codigo              String
  nombre              String
  categoria           String?
  unidadMedida        String   @default("unidad") @map("unidad_medida")
  existencia          Decimal  @default(0) @db.Decimal(12, 3)
  existenciaReservada Decimal  @default(0) @map("existencia_reservada") @db.Decimal(12, 3)
  stockMinimo         Decimal  @default(0) @map("stock_minimo") @db.Decimal(12, 3)
  costoUnitario       Decimal  @default(0) @map("costo_unitario") @db.Decimal(12, 4)
  activo              Boolean  @default(true)
  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn       DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  insumosDe   ProductoInsumo[]
  movimientos MovimientoInventario[]

  @@unique([empresaId, codigo])
  @@map("items_inventario")
}

/// BOM: qué ítems de inventario y en qué cantidad requiere UNA unidad de un
/// ProductoInterno. Puente real (por FK, no por texto) entre "lo que se
/// vende" y "lo que se reserva/consume".
model ProductoInsumo {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId          String          @map("empresa_id") @db.Uuid
  empresa            Empresa         @relation(fields: [empresaId], references: [id])
  productoInternoId  String          @map("producto_interno_id") @db.Uuid
  productoInterno    ProductoInterno @relation(fields: [productoInternoId], references: [id])
  itemInventarioId   String          @map("item_inventario_id") @db.Uuid
  itemInventario     ItemInventario  @relation(fields: [itemInventarioId], references: [id])
  cantidadPorUnidad  Decimal         @map("cantidad_por_unidad") @db.Decimal(12, 4)

  @@unique([productoInternoId, itemInventarioId])
  @@map("producto_insumos")
}

/// Ledger de movimientos: ENTRADA | RESERVA | CONSUMO | LIBERACION | AJUSTE.
/// RESERVA/LIBERACION pueblan pedidoId (orden/etapa quedan NULL); CONSUMO
/// puebla ordenProduccionId+etapaId (pedidoId queda NULL) — así conviven las
/// dos restricciones únicas de idempotencia sin índices parciales (Postgres
/// no aplica UNIQUE entre filas con NULL en alguna columna de la restricción).
model MovimientoInventario {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId           String           @map("empresa_id") @db.Uuid
  empresa             Empresa          @relation(fields: [empresaId], references: [id])
  itemInventarioId    String           @map("item_inventario_id") @db.Uuid
  itemInventario      ItemInventario   @relation(fields: [itemInventarioId], references: [id])
  tipo                String
  cantidad            Decimal          @db.Decimal(12, 3)
  pedidoId            String?          @map("pedido_id") @db.Uuid
  pedido              Pedido?          @relation(fields: [pedidoId], references: [id])
  ordenProduccionId   String?          @map("orden_produccion_id") @db.Uuid
  ordenProduccion     OrdenProduccion? @relation(fields: [ordenProduccionId], references: [id])
  etapaId             Int?             @map("etapa_id")
  etapa               Etapa?           @relation(fields: [etapaId], references: [id])
  referencia          String?
  usuarioId           String?          @map("usuario_id") @db.Uuid
  usuario             Usuario?         @relation(fields: [usuarioId], references: [id])
  fecha               DateTime         @default(now()) @db.Timestamptz(6)

  @@unique([empresaId, pedidoId, itemInventarioId, tipo], map: "uq_movimiento_reserva_liberacion")
  @@unique([empresaId, ordenProduccionId, etapaId, itemInventarioId, tipo], map: "uq_movimiento_consumo")
  @@map("movimientos_inventario")
}

/// Costo por pedido — costoReal/utilidadReal/margenReal quedan NULL hasta
/// que exista una fase futura que los calcule desde el consumo real
/// completo. fuente="estimado_temporal" documenta honestamente que el
/// estimado usa un factor fijo, no un costeo real todavía.
model CostoPedido {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  empresa           Empresa  @relation(fields: [empresaId], references: [id])
  pedidoId          String   @unique @map("pedido_id") @db.Uuid
  pedido            Pedido   @relation(fields: [pedidoId], references: [id])
  costoEstimado     Decimal  @map("costo_estimado") @db.Decimal(12, 2)
  costoReal         Decimal? @map("costo_real") @db.Decimal(12, 2)
  utilidadEstimada  Decimal  @map("utilidad_estimada") @db.Decimal(12, 2)
  utilidadReal      Decimal? @map("utilidad_real") @db.Decimal(12, 2)
  margenEstimado    Decimal? @map("margen_estimado") @db.Decimal(6, 4)
  margenReal        Decimal? @map("margen_real") @db.Decimal(6, 4)
  /// {"material": x, "produccion": y, "otros": z}
  desglose          Json     @default("{}")
  fuente            String   @default("estimado_temporal")
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn     DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("costos_pedido")
}

// Vista de solo lectura para reportes/dashboard. Prisma puede leerla
/// (`prisma.vOrdenesProduccionEstado.findMany()`) pero nunca escribirla.
/// Lógica de "situacion"/"diasRestantes" vive en la definición SQL de la
/// vista (ver informe de introspección), no se re-implementa en Prisma.
view VOrdenesProduccionEstado {
  id                   String    @id @db.Uuid
  pedidoId             String    @map("pedido_id") @db.Uuid
  empresaId            String    @map("empresa_id") @db.Uuid
  opId                 String    @map("op_id")
  producto             String
  cantidad             Int
  tipoTrabajo          String?   @map("tipo_trabajo")
  medida               String?
  etapaId              Int       @map("etapa_id")
  prioridadId          Int       @map("prioridad_id")
  responsableUsuarioId String?   @map("responsable_usuario_id") @db.Uuid
  responsableExterno   String?   @map("responsable_externo")
  fechaEntregaReal     DateTime? @map("fecha_entrega_real") @db.Date
  observaciones        String?
  creadoEn             DateTime? @map("creado_en") @db.Timestamptz(6)
  actualizadoEn        DateTime? @map("actualizado_en") @db.Timestamptz(6)
  eliminadoEn          DateTime? @map("eliminado_en") @db.Timestamptz(6)
  estaEntregada        Boolean?  @map("esta_entregada")
  situacion            String?
  diasRestantes        Int?      @map("dias_restantes")

  @@map("v_ordenes_produccion_estado")
}

// ----------------------------------------------------------------------------
// ATLAS — núcleo técnico del futuro módulo COMERCIAL (Sprint 0.1,
// 2026-07-31; corrección arquitectónica 0.1.1, misma fecha; reclasificado
// como núcleo de Comercial en Subfase 0.2 — ver docs/atlas/DECISIONES.md y
// docs/atlas/ARQUITECTURA_COMERCIAL.md). ATLAS dejó de pensarse como un
// módulo aislado: es el motor de Inbox/Leads/Contactos de un ecosistema
// Comercial más amplio (que también incluirá Campañas, Automatizaciones,
// Seguimientos, Embudos y Reportes, y absorberá al CRM actual). Los
// nombres de modelo/tabla se mantienen "Atlas*"/"atlas_*" deliberadamente
// — renombrarlos ahora, antes de que Campañas/Embudos/Automatizaciones
// tengan siquiera un diseño, sería construir sobre una decisión de
// nomenclatura que todavía puede cambiar.
//
// Capta, clasifica y da seguimiento a leads de Instagram, WhatsApp,
// Facebook, TikTok y el catálogo público, ANTES de que exista un Pedido.
// Deliberadamente separado de `Cliente` (ver clientes.service.js): Cliente
// es identidad post-facturación (find-or-create solo al emitir
// PEDIDO_FACTURADO); AtlasContacto existe desde el primer mensaje, mucho
// antes — y puede no convertirse nunca. El vínculo hacia Pedido es opcional
// y explícito (pedidoId), nunca una fusión de tablas. Cliente tampoco se
// fusiona con AtlasContacto ahora — el puente entre "lead" y "cliente
// facturado" queda documentado como trabajo futuro del módulo Comercial,
// no como algo que esta fundación ya resuelve.
//
// Corrección 0.1.1: se separó identidad de PERSONA (AtlasContacto) de
// identidad POR CANAL (AtlasIdentidadCanal) — un mismo humano que escribe
// por Instagram, WhatsApp y el catálogo debe terminar siendo UN
// AtlasContacto con TRES AtlasIdentidadCanal, no tres contactos sueltos.
// La fusión entre identidades NUNCA es automática por nombre parecido —
// solo por coincidencia fuerte y verificable (teléfono/email validado) o
// fusión manual auditada (ver fusionarContactos en contactos.service.js).
//
// Borrador de fundación técnica: NO aplicado todavía contra la base real
// (ver server/prisma/migrations_manual/0007_atlas_fundacion.sql).
// ----------------------------------------------------------------------------

/// La PERSONA — identidad comercial unificada, independiente de por cuántos
/// canales haya escrito. Nunca contiene el identificador de un canal
/// puntual (eso vive en AtlasIdentidadCanal) — así evitamos que el mismo
/// humano escribiendo por Instagram y luego por WhatsApp cree dos
/// contactos distintos.
model AtlasContacto {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId           String    @map("empresa_id") @db.Uuid
  empresa             Empresa   @relation(fields: [empresaId], references: [id])

  nombrePreferido     String?   @map("nombre_preferido")
  /// Solo se completa cuando ese teléfono ya fue VALIDADO en alguna
  /// AtlasIdentidadCanal (ver identidades.service.js) — es el único dato
  /// que contactos.service.js usa para intentar una fusión fuerte.
  telefonoPrincipal   String?   @map("telefono_principal")
  emailPrincipal      String?   @map("email_principal")

  intencionActual     String?   @map("intencion_actual")
  /// Ver TIPOS_CLIENTE en config.js. Default "no_clasificado".
  tipoCliente         String    @default("no_clasificado") @map("tipo_cliente")
  /// Ver ESTADOS_COMERCIALES en config.js. Default "nuevo".
  estadoComercial     String    @default("nuevo") @map("estado_comercial")

  ultimoContacto      DateTime? @map("ultimo_contacto") @db.Timestamptz(6)
  proximaAccion       String?   @map("proxima_accion")

  /// Consentimiento GENERAL (paraguas) — el detalle real, por canal
  /// (fecha/fuente, estado de suscripción, motivo de baja), vive en
  /// AtlasIdentidadCanal, porque alguien puede aceptar WhatsApp y bloquear
  /// Instagram al mismo tiempo. Este campo es el "¿puedo contactar a esta
  /// persona en general?" de un vistazo.
  consentimiento      Boolean   @default(false)

  /// Snapshot congelado del PRIMER touch de atribución (nunca se
  /// sobreescribe una vez creado) y del ÚLTIMO touch (se reemplaza en cada
  /// interacción nueva con UTM/fbclid presentes). Forma:
  /// { utmSource, utmMedium, utmCampaign, utmContent, utmTerm, campaignId,
  ///   adsetId, adId, fbclid, fechaAtribucion, urlEntrada, canal }
  /// JSON (no 22 columnas planas) — ver DECISIONES.md, punto 6.
  atribucionPrimerToque Json?   @map("atribucion_primer_toque")
  atribucionUltimoToque Json?   @map("atribucion_ultimo_toque")

  /// Vínculo OPCIONAL y explícito — nunca implica que AtlasContacto y
  /// Cliente/Pedido sean la misma entidad. Se completa recién cuando el
  /// lead genera de verdad una SolicitudPedido/Pedido real.
  /// onDelete: SetNull — si algún día un Pedido se hard-elimina (no es el
  /// patrón habitual, todo acá usa soft-delete), el contacto no debe
  /// bloquear ni perder su propio historial por eso, solo pierde ESTE
  /// vínculo puntual.
  pedidoId            String?   @map("pedido_id") @db.Uuid
  pedido              Pedido?   @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  /// onDelete: SetNull — un usuario/empleado que se da de baja no debe
  /// bloquear su borrado por ser responsable de contactos viejos.
  responsableUsuarioId String?  @map("responsable_usuario_id") @db.Uuid
  responsableUsuario   Usuario? @relation(fields: [responsableUsuarioId], references: [id], onDelete: SetNull)
  etiquetas           String[]  @default([])

  /// Fusión manual auditada (nunca automática): cuando dos AtlasContacto
  /// resultan ser la misma persona, el "perdedor" queda con este campo
  /// apuntando al sobreviviente en vez de borrarse — conserva el historial
  /// completo (regla de Parte 5: "ningún mensaje se elimina" se extiende a
  /// "ningún contacto se elimina al fusionar"). Ver fusionarContactos() —
  /// esa función también es la que impide CICLOS (A fusionado a B y B
  /// fusionado a A): Postgres no puede expresar "sin ciclos" en un FK
  /// autorreferenciado, así que la validación vive en el service, igual
  /// criterio que el resto de las reglas de negocio de este proyecto.
  /// onDelete: Restrict — no se puede borrar un contacto al que OTROS ya
  /// fueron fusionados sin resolver eso primero explícitamente.
  /// Auditoría Subfase 0.3 (Punto 4a): la base real tiene además un CHECK
  /// `fusionado_en_id <> id` (defensa adicional a nivel de columna, junto
  /// con creariaCiclo() en contactos.service.js que cubre ciclos de más de
  /// un nodo, que un CHECK no puede expresar). Prisma no soporta
  /// restricciones CHECK en su DSL — no hay forma de reflejar esto acá,
  /// solo queda documentado. Ver 0008_atlas_fundacion.sql.
  fusionadoEnId       String?   @map("fusionado_en_id") @db.Uuid
  fusionadoEn         AtlasContacto?  @relation("FusionContacto", fields: [fusionadoEnId], references: [id], onDelete: Restrict)
  fusionesRecibidas   AtlasContacto[] @relation("FusionContacto")

  creadoEn            DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn       DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  identidadesCanal    AtlasIdentidadCanal[]
  tokensAtribucion    AtlasAtribucionToken[]

  @@index([empresaId, estadoComercial])
  /// Auditoría Subfase 0.3 (Punto 2): existe SOLO para poder ser el
  /// destino de la FK compuesta de AtlasIdentidadCanal/AtlasAtribucionToken
  /// — un contacto ya es único por `id` (PK), esto es la mitad "empresaId"
  /// que una FK compuesta necesita del lado referenciado. Sin esto, una
  /// identidad o un token podrían declarar una empresa distinta a la de su
  /// propio contacto, ni siquiera con SQL directo lo permite ahora.
  @@unique([id, empresaId], map: "uq_atlas_contactos_id_empresa")
  @@map("atlas_contactos")
}

/// Una identidad POR CANAL — el mismo AtlasContacto puede tener varias (una
/// de Instagram, una de WhatsApp, una del catálogo...). Es acá donde vive
/// el identificador externo, y es la única unicidad real: "no repetir la
/// misma identidad dentro de la empresa y el canal", no "no repetir la
/// misma persona" (eso lo decide la fusión manual/fuerte, nunca esta
/// constraint).
model AtlasIdentidadCanal {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId           String    @map("empresa_id") @db.Uuid
  empresa             Empresa   @relation(fields: [empresaId], references: [id])
  atlasContactoId     String    @map("atlas_contacto_id") @db.Uuid
  /// onDelete: Restrict — jamás se borra el historial de conversación
  /// de un contacto de forma silenciosa/en cascada.
  /// Auditoría Subfase 0.3 (Punto 2): relación COMPUESTA contra
  /// AtlasContacto(id, empresaId), no solo contra su id — impide que esta
  /// identidad declare una empresa distinta a la de su propio contacto, ni
  /// siquiera con SQL directo. La FK directa hacia Empresa (arriba) queda
  /// igual — es redundante en este modelo (atlasContactoId nunca es NULL
  /// acá, así que la compuesta siempre alcanza), pero no incorrecta.
  atlasContacto        AtlasContacto @relation(fields: [atlasContactoId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "fk_atlas_identidades_canal_contacto_empresa")

  /// instagram | whatsapp | facebook | tiktok | catalogo (ver CANALES en
  /// server/src/services/atlas/config.js).
  canal               String
  /// ID nativo de la plataforma (ID de Instagram, número de WhatsApp, PSID
  /// de Messenger...).
  identificadorExterno String   @map("identificador_externo")
  /// ID interno del PROVEEDOR intermediario (ej. subscriber ID de
  /// ManyChat) — distinto del identificador nativo de la plataforma;
  /// puede no existir si se integra directo contra Meta/WhatsApp Cloud.
  identificadorProveedor String? @map("identificador_proveedor")

  nombreUsuario       String?   @map("nombre_usuario")
  telefono            String?
  email               String?
  /// true solo cuando telefono/email de ESTA identidad fue confirmado por
  /// un mecanismo real (respuesta a un código, coincidencia con Cliente
  /// facturado, etc.) — jamás por defecto. Es la señal que
  /// contactos.service.js exige para intentar una fusión fuerte.
  verificado          Boolean   @default(false)

  /// Datos crudos específicos del proveedor que no ameritan columna propia
  /// (ej. metadata de ManyChat, campos de Graph API sin mapear todavía).
  datosAdicionales    Json?     @map("datos_adicionales")

  /// activo | inactivo | fusionado — "fusionado" cuando esta identidad se
  /// reasignó a otro AtlasContacto tras una fusión manual (ver
  /// fusionarContactos()), sin borrarla.
  estado              String    @default("activo")

  /// Consentimiento y salida — POR CANAL (Parte 7): alguien puede aceptar
  /// mensajes de WhatsApp y estar bloqueado en Instagram al mismo tiempo.
  consentimientoCanal   Boolean   @default(false) @map("consentimiento_canal")
  consentimientoFecha   DateTime? @map("consentimiento_fecha") @db.Timestamptz(6)
  consentimientoFuente  String?   @map("consentimiento_fuente")
  /// activo | baja | bloqueado — ver ESTADOS_SUSCRIPCION en config.js.
  estadoSuscripcion     String    @default("activo") @map("estado_suscripcion")
  fechaBaja             DateTime? @map("fecha_baja") @db.Timestamptz(6)
  motivoBloqueo         String?   @map("motivo_bloqueo")

  primeraInteraccion  DateTime  @default(now()) @map("primera_interaccion") @db.Timestamptz(6)
  ultimaInteraccion   DateTime  @default(now()) @map("ultima_interaccion") @db.Timestamptz(6)

  conversaciones      AtlasConversacion[]

  @@unique([empresaId, canal, identificadorExterno])
  @@index([atlasContactoId])
  @@map("atlas_identidades_canal")
}

/// Token público opaco para enlaces de atribución (?ref=<token>) — NUNCA el
/// id interno de AtlasContacto. `token` es un valor aleatorio propio,
/// deliberadamente distinto de `id`, para que ni exponiendo el token se
/// pueda deducir ni enumerar contactos (ver atribucion.service.js).
model AtlasAtribucionToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String    @map("empresa_id") @db.Uuid
  empresa           Empresa   @relation(fields: [empresaId], references: [id])
  /// NULLABLE (Auditoría Subfase 0.3, Punto 3): un token nace SIN contacto
  /// cuando representa un clic anónimo de un anuncio o del catálogo —
  /// recién se "reclama" (vincularTokenAContacto(), en
  /// atribucion.service.js) cuando esa persona se identifica más
  /// adelante. Flujo completo documentado en la cabecera de
  /// atribucion.service.js y en DECISIONES.md, Decisión 13.
  atlasContactoId   String?   @map("atlas_contacto_id") @db.Uuid
  /// onDelete: Restrict — mismo criterio que el resto: no se pierde
  /// silenciosamente el registro de atribución de un contacto.
  /// Relación COMPUESTA (Punto 2, igual que AtlasIdentidadCanal) — a
  /// diferencia de esa, acá la FK directa hacia Empresa (arriba) NO es
  /// redundante: mientras el token es anónimo (atlasContactoId NULL),
  /// Postgres no evalúa una FK compuesta con una columna NULL (MATCH
  /// SIMPLE) — la FK directa es la ÚNICA que valida empresaId en ese
  /// caso. Una vez reclamado el token, ambas se cumplen.
  atlasContacto      AtlasContacto? @relation(fields: [atlasContactoId, empresaId], references: [id, empresaId], onDelete: Restrict, map: "fk_atlas_atribucion_tokens_contacto_empresa")

  /// Valor opaco expuesto en la URL — aleatorio (crypto.randomBytes), NO
  /// derivado de ningún id interno. Ver crearTokenAtribucion().
  token             String    @unique(map: "uq_atlas_atribucion_tokens_token")

  canal             String?
  campana           String?
  anuncio           String?
  utmSource         String?   @map("utm_source")
  utmMedium         String?   @map("utm_medium")
  utmCampaign       String?   @map("utm_campaign")
  utmContent        String?   @map("utm_content")
  utmTerm           String?   @map("utm_term")
  campaignId        String?   @map("campaign_id")
  adsetId           String?   @map("adset_id")
  adId              String?   @map("ad_id")
  fbclid            String?

  /// Extensión Sprint 0.2-corrección (2026-07-31): nace preparado para más
  /// plataformas/click-IDs que UTM/Meta puro, aunque hoy la mayoría llegue
  /// vacía — agregarlos después de tener contactos reales sería una
  /// migración con backfill imposible (el dato del touch original ya se
  /// habría perdido para siempre).
  placement         String?   // ubicación del anuncio (feed, stories, reels...)
  device            String?   // mobile | desktop | tablet, tal como lo reporte el proveedor
  gclid             String?   // Google Click ID
  ttclid            String?   // TikTok Click ID
  landingUrl        String?   @map("landing_url") // URL exacta de aterrizaje (con querystring)
  referer           String?   // header Referer del navegador, si estaba disponible

  fechaExpiracion   DateTime? @map("fecha_expiracion") @db.Timestamptz(6)
  fechaPrimerUso    DateTime? @map("fecha_primer_uso") @db.Timestamptz(6)
  cantidadUsos      Int       @default(0) @map("cantidad_usos")
  /// activo | revocado
  estado            String    @default("activo")

  creadoEn          DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([atlasContactoId])
  @@map("atlas_atribucion_tokens")
}

/// Idempotencia de webhooks (Parte 3 de la corrección): la MISMA
/// interacción reenviada varias veces por Meta/ManyChat no puede crear
/// varios mensajes/contactos/respuestas. Deliberadamente SIN empresaId: es
/// una tabla técnica de deduplicación, no una entidad de negocio — todavía
/// no sabemos a qué empresa/contacto pertenece un evento hasta procesarlo.
model AtlasWebhookEvento {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// manychat | meta | whatsapp_cloud (proveedor técnico, no confundir con
  /// `canal` de negocio — un proveedor puede servir varios canales).
  proveedor           String
  canal               String?
  /// ID de evento del proveedor, cuando lo manda (no todos garantizan
  /// uno estable) — dedup primario cuando existe.
  eventIdExterno      String?  @map("event_id_externo")
  /// sha256 del payload crudo — dedup de respaldo cuando eventIdExterno no
  /// viene o no es confiable.
  payloadHash         String   @map("payload_hash")
  fechaRecibida       DateTime @default(now()) @map("fecha_recibida") @db.Timestamptz(6)
  /// pendiente | procesado | error
  estadoProcesamiento String   @default("pendiente") @map("estado_procesamiento")
  cantidadIntentos    Int      @default(1) @map("cantidad_intentos")
  ultimoError         String?  @map("ultimo_error")

  // Auditoría Subfase 0.3 (Punto 1): un UNIQUE(proveedor, eventIdExterno)
  // normal NO alcanza — Postgres permite múltiples NULL ahí, así que dos
  // webhooks sin eventIdExterno nunca chocarían. La base real tiene DOS
  // ÍNDICES ÚNICOS PARCIALES en su lugar: uno para proveedor+eventIdExterno
  // WHERE eventIdExterno IS NOT NULL, otro para proveedor+payloadHash WHERE
  // eventIdExterno IS NULL. Prisma no soporta índices parciales en su DSL
  // (mismo caso ya documentado para OrdenProduccion más arriba) — este
  // @@index es una aproximación SIN el WHERE parcial. NO correr
  // `migrate dev`/`db push` sin revisar el diff. Ver
  // 0008_atlas_fundacion.sql e idempotencia.service.js.
  @@index([proveedor, eventIdExterno])
  @@map("atlas_webhook_eventos")
}

/// Una conversación por (identidad de canal) — agrupa los mensajes de un
/// mismo hilo dentro de ESE canal puntual (no del contacto unificado: si la
/// misma persona escribe por Instagram y WhatsApp, son dos conversaciones,
/// una por cada AtlasIdentidadCanal).
model AtlasConversacion {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identidadCanalId    String   @map("identidad_canal_id") @db.Uuid
  /// onDelete: Restrict — no se pierde una conversación entera borrando su
  /// identidad de canal por accidente.
  identidadCanal      AtlasIdentidadCanal @relation(fields: [identidadCanalId], references: [id], onDelete: Restrict)
  /// `canal` se eliminó de acá (Auditoría Subfase 0.3, Punto 4b): duplicaba
  /// identidadCanal.canal sin ninguna razón real — el canal de una
  /// identidad no cambia nunca después de creada, así que no era un
  /// snapshot con valor propio. Leer el canal de una conversación es
  /// `conversacion.identidadCanal.canal`.
  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  mensajes            AtlasMensaje[]

  @@index([identidadCanalId])
  @@map("atlas_conversaciones")
}

/// Mensaje individual — "ningún mensaje se elimina" (Parte 5): esta tabla
/// es de solo agregar filas, nunca update destructivo de contenido.
model AtlasMensaje {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversacionId      String   @map("conversacion_id") @db.Uuid
  /// onDelete: Restrict — regla dura del sprint: "ningún mensaje se
  /// elimina" se extiende a nivel de FK, no solo de convención de código.
  conversacion        AtlasConversacion @relation(fields: [conversacionId], references: [id], onDelete: Restrict)

  /// entrante | saliente
  direccion           String
  /// cliente | automatico | humano — quién redactó este mensaje puntual.
  origen              String
  contenido           String
  intencionDetectada  String?  @map("intencion_detectada")
  /// Identificador del proveedor (ManyChat/Meta) para poder cruzar con
  /// AtlasWebhookEvento si hace falta auditar de dónde vino.
  idProveedor         String?  @map("id_proveedor")

  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([conversacionId])
  @@map("atlas_mensajes")
}
