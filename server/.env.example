DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
PORT=4000
# Lista separada por comas: el ERP (client/) y el catálogo público
# (catalogo/) se sirven desde subdominios distintos pero llaman al mismo backend.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
# UUID de la Empresa (tabla empresas) cuyo catálogo expone /api/publico.
# Sin esto, las rutas públicas del catálogo responden error.
CATALOGO_EMPRESA_ID=""
